# ===== 询盘邮件发送配置（复制本文件为 .env.local 后填写）=====

# 方案 A：Resend（推荐）
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM=华域精工 <noreply@your-domain.com>

# 方案 B：Nodemailer + 企业邮箱 SMTP
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_USER=sales@your-domain.com
SMTP_PASS=your-smtp-password

# 询盘接收邮箱（两种方案通用）
INQUIRY_TO=sales@your-domain.com
